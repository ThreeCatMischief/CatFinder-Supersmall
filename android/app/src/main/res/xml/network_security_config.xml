<?xml version="1.0" encoding="utf-8"?>
<!-- The robot serves plain HTTP on the home network. Away from home, remote
     access goes through Tailscale, which encrypts the traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
